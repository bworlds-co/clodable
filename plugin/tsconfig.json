{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "hooks",
    "types",
    "tests",
    ".claude-plugin/types/claude-code/index.d.ts",
    ".claude-plugin/types/claude-code-tools/index.d.ts"
  ]
}
