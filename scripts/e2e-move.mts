/**
 * The move off Lovable, end to end on a real (local) Supabase.
 *
 * 1. A Lovable Cloud-like app: people signed up through Supabase Auth, a new-user trigger, access
 *    rules, an identity column, a private file rule, a function naming the old backend.
 * 2. Its export, made the way Lovable makes it: pg_dump 18, custom format, zstd, zipped.
 * 3. A fresh project, and Clodable's copy into it as Supabase's own `postgres` role (not a
 *    superuser), with the PostgreSQL tools Clodable fetches for builders.
 * 4. Proof: the checks agree, people sign in with their original passwords, a session from before
 *    the move still refreshes, a new sign-up gets its profile, a new post saves.
 *
 *   pnpm tsx scripts/e2e-move.mts
 *
 * Needs Docker and the supabase CLI. Runs its own stack on ports 55320-55329 under the project id
 * clodable-e2e-move, and stops only that one: other local Supabase projects are left alone.
 */
import { execFileSync } from "node:child_process";
import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { postgresTool, psqlSql, runFlow } from "../packages/core/src/index.ts";
import { readExport } from "../packages/core/src/move/export.ts";
import { copyExport } from "../packages/core/src/move/restore.ts";
import { verifyCopy } from "../packages/core/src/move/verify.ts";
import { makeZip } from "../packages/core/test/move-fixtures.ts";

const SRC = "srcsrcsrcsrcsrcsrcsr";
const DST = "dstdstdstdstdstdstds";
const PORTS = {
  api: 55321,
  db: 55322,
  shadow: 55320,
  studio: 55323,
  smtp: 55324,
  analytics: 55327,
  pooler: 55329,
};

const APP = `
create table public.profiles (id uuid primary key references auth.users(id) on delete cascade, display_name text, avatar_url text);
alter table public.profiles enable row level security;
create policy "own profile" on public.profiles for select to authenticated using (auth.uid() = id);
create policy "update own profile" on public.profiles for update to authenticated using (auth.uid() = id);
create table public.posts (id bigint generated by default as identity primary key, author uuid not null references public.profiles(id), title text not null, created_at timestamptz default now());
alter table public.posts enable row level security;
create policy "read posts" on public.posts for select using (true);
create policy "write own posts" on public.posts for insert to authenticated with check (auth.uid() = author);
create function public.handle_new_user() returns trigger language plpgsql security definer set search_path = public as $$
begin insert into public.profiles (id, display_name) values (new.id, new.raw_user_meta_data->>'name'); return new; end $$;
create trigger on_auth_user_created after insert on auth.users for each row execute function public.handle_new_user();
insert into storage.buckets (id, name, public) values ('avatars', 'avatars', false), ('images', 'images', true);
create policy "own avatar" on storage.objects for select to authenticated using (bucket_id = 'avatars' and owner_id = auth.uid()::text);
create function public.digest_url() returns text language sql as $$ select 'https://${SRC}.supabase.co/functions/v1/digest' $$;
-- What a working app grants its API (newer Supabase projects don't grant it on their own).
grant select, insert, update, delete on public.posts, public.profiles to authenticated;
grant select on public.posts to anon;
`;

const step = (text: string) => console.log(`\n▸ ${text}`);
const ok = (text: string) => console.log(`  ✓ ${text}`);
function check(condition: unknown, text: string) {
  if (!condition) throw new Error(`✕ ${text}`);
  ok(text);
}

const dir = await mkdtemp(join(tmpdir(), "clodable-e2e-move-"));
const supabase = (...args: string[]) =>
  execFileSync("supabase", [...args, "--workdir", dir], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });

async function startFresh(withApp: boolean) {
  await rm(join(dir, "supabase", "migrations"), { recursive: true, force: true });
  if (withApp) {
    execFileSync("mkdir", ["-p", join(dir, "supabase", "migrations")]);
    await writeFile(join(dir, "supabase", "migrations", "20250101000000_app.sql"), APP);
  }
  supabase(
    "start",
    "-x",
    "analytics,edge-runtime,functions,imgproxy,inbucket,realtime,studio,vector,meta",
  );
  const status = JSON.parse(supabase("status", "-o", "json")) as Record<string, string>;
  return {
    api: status.API_URL!,
    anon: status.ANON_KEY ?? status.PUBLISHABLE_KEY!,
    service: status.SERVICE_ROLE_KEY ?? status.SECRET_KEY!,
  };
}

async function auth(api: string, key: string, path: string, body: unknown, bearer = key) {
  const response = await fetch(`${api}/auth/v1/${path}`, {
    method: "POST",
    headers: { apikey: key, Authorization: `Bearer ${bearer}`, "content-type": "application/json" },
    body: JSON.stringify(body),
  });
  // biome-ignore lint/suspicious/noExplicitAny: Supabase Auth's answers, read loosely.
  const answer = (await response.json().catch(() => ({}))) as Record<string, any>;
  return { status: response.status, body: answer };
}

const target = {
  host: "127.0.0.1",
  port: PORTS.db,
  user: "postgres",
  password: "postgres",
  database: "postgres",
  ssl: false,
};

try {
  step("A Lovable Cloud-like app on a local Supabase");
  supabase("init");
  let config = await readFile(join(dir, "supabase", "config.toml"), "utf8");
  config = config
    .replace(/^project_id = .*$/m, 'project_id = "clodable-e2e-move"')
    .replace(/^port = 54321$/m, `port = ${PORTS.api}`)
    .replace(/^port = 54322$/m, `port = ${PORTS.db}`)
    .replace(/^shadow_port = 54320$/m, `shadow_port = ${PORTS.shadow}`)
    .replace(/^port = 54323$/m, `port = ${PORTS.studio}`)
    .replace(/^port = 54324$/m, `port = ${PORTS.smtp}`)
    .replace(/^port = 54327$/m, `port = ${PORTS.analytics}`)
    .replace(/^port = 54329$/m, `port = ${PORTS.pooler}`);
  await writeFile(join(dir, "supabase", "config.toml"), config);
  const before = await startFresh(true);
  ok(`running at ${before.api}`);

  const people = [
    { email: "ada@example.com", password: "ada-original-pass-1", name: "Ada" },
    { email: "bob@example.com", password: "bob-original-pass-2", name: "Bob" },
    { email: "cy@example.com", password: "cy-original-pass-3", name: "Cy" },
  ];
  for (const p of people) {
    const created = await auth(before.api, before.service, "admin/users", {
      email: p.email,
      password: p.password,
      email_confirm: true,
      user_metadata: { name: p.name },
    });
    check(created.status === 200, `${p.name} signed up`);
  }
  const session = await auth(before.api, before.anon, "token?grant_type=password", {
    email: people[0]!.email,
    password: people[0]!.password,
  });
  check(session.status === 200, "Ada signed in (a session and a refresh token exist)");
  const oldRefresh = String(session.body.refresh_token);
  const sql = psqlSql(target);
  await sql.run(
    "insert into public.posts (author, title) select id, 'Hello from ' || email from auth.users;",
  );
  const sourcePost = await fetch(`${before.api}/rest/v1/posts`, {
    method: "POST",
    headers: {
      apikey: before.anon,
      Authorization: `Bearer ${session.body.access_token}`,
      "content-type": "application/json",
    },
    body: JSON.stringify({ author: session.body.user.id, title: "Before the move" }),
  });
  check(sourcePost.status === 201, "Ada posts through the app's API");

  step("Lovable's export: pg_dump 18, custom format, zstd, zipped");
  const backup = join(dir, "app_261011.backup");
  execFileSync(await postgresTool("pg_dump"), ["-Fc", "--compress=zstd", "-f", backup], {
    env: {
      ...process.env,
      PGHOST: "127.0.0.1",
      PGPORT: String(PORTS.db),
      PGUSER: "supabase_admin",
      PGPASSWORD: "postgres",
      PGDATABASE: "postgres",
    },
  });
  const zip = join(dir, "export.zip");
  await writeFile(
    zip,
    makeZip([{ name: "app_261011.backup", data: await readFile(backup), deflate: true }]),
  );
  ok("exported");

  step("A fresh Supabase project");
  supabase("stop", "--no-backup");
  const after = await startFresh(false);
  ok("running, empty");

  step("Clodable reads the export and copies it in");
  const work = join(dir, "move");
  execFileSync("mkdir", ["-p", work]);
  const { summary, toc } = await readExport(zip, work);
  ok(`${Object.keys(summary.rows).length} tables · ${summary.people.total} people`);
  const outcome = await runFlow(
    copyExport({ pg: target, sql, ref: DST, keys: {} }, work, toc, summary, { sourceRef: SRC }),
    (event) => {
      if (event.type === "step" && event.state !== "running") console.log(`    ${event.title}`);
    },
  );
  if (outcome.problems.length > 0) console.log("  problems:", outcome.problems);
  check(outcome.problems.length === 0, "copied without a problem");
  const checks = await verifyCopy(sql, summary, { sourceRef: SRC });
  for (const c of checks)
    console.log(`    ${c.ok ? "✓" : "!"} ${c.label}${c.detail ? ` · ${c.detail}` : ""}`);
  check(
    checks.every((c) => c.ok),
    "every check agrees",
  );

  step("People and the app, on the copy");
  for (const p of people) {
    const signIn = await auth(after.api, after.anon, "token?grant_type=password", {
      email: p.email,
      password: p.password,
    });
    check(signIn.status === 200, `${p.name} signs in with the password they always had`);
  }
  const refreshed = await auth(after.api, after.anon, "token?grant_type=refresh_token", {
    refresh_token: oldRefresh,
  });
  check(refreshed.status === 200, "Ada's session from before the move carries on");
  const newcomer = await auth(after.api, after.service, "admin/users", {
    email: "dee@example.com",
    password: "dee-new-pass-4",
    email_confirm: true,
    user_metadata: { name: "Dee" },
  });
  check(newcomer.status === 200, "a new person signs up");
  const [profile] = await sql.rows<{ name: string }>(
    "select display_name as name from public.profiles where id = (select id from auth.users where email = 'dee@example.com')",
  );
  check(profile?.name === "Dee", "and gets a profile from the new-user trigger");
  const token = String(refreshed.body.access_token);
  const post = await fetch(`${after.api}/rest/v1/posts`, {
    method: "POST",
    headers: {
      apikey: after.anon,
      Authorization: `Bearer ${token}`,
      "content-type": "application/json",
      Prefer: "return=representation",
    },
    body: JSON.stringify({ author: refreshed.body.user.id, title: "After the move" }),
  });
  if (post.status !== 201) console.log("  answer:", post.status, await post.text());
  check(post.status === 201, "Ada posts again: new rows save, access rules hold");
  const mine = await fetch(`${after.api}/rest/v1/profiles?select=display_name`, {
    headers: { apikey: after.anon, Authorization: `Bearer ${token}` },
  });
  const visible = (await mine.json()) as unknown[];
  check(visible.length === 1, "Ada sees only her own profile");
  const [digest] = await sql.rows<{ url: string }>("select public.digest_url() as url");
  check(digest?.url.includes(DST) && !digest.url.includes(SRC), "functions call the new backend");
  console.log("\nThe move works on a real Supabase.\n");
} finally {
  try {
    supabase("stop", "--no-backup");
  } catch {}
  await rm(dir, { recursive: true, force: true });
}
