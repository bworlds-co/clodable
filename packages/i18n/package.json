{
  "name": "@clodable/i18n",
  "version": "0.4.3",
  "description": "Clodable language catalogs and formatting.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/index.ts",
    "./core": "./src/core.ts",
    "./cli": "./src/cli.ts",
    "./preview": "./src/preview.ts",
    "./mod": "./src/mod.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "./preview": {
        "types": "./dist/preview.d.ts",
        "default": "./dist/preview.js"
      },
      "./mod": {
        "types": "./dist/mod.d.ts",
        "default": "./dist/mod.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  }
}
